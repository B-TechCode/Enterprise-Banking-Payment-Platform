# Copy to .env (same directory) and fill in. .env is gitignored; this file is
# the committed template and must never hold real secrets.
#
# docker compose reads .env from this directory automatically. A variable set in
# the shell takes precedence over the same name here.

# --- Database -----------------------------------------------------------------
# Used both to initialise Postgres and by every service to connect to it.
# Postgres applies these only when its data volume is first created: changing
# them later does not change the password of an existing volume.
DIGITALBANK_DB_USER=postgres
DIGITALBANK_DB_PASSWORD=change-me

# --- Gemini (AI Commerce Agent) -------------------------------------------------
# Required. Best left out of this file and set in the shell instead (for example
# as a user-level environment variable), so the key is never written to disk
# next to the project. Compose refuses to start if it is set in neither place.
# GEMINI_API_KEY=

# --- Auth0 --------------------------------------------------------------------
# Token validation. The defaults point at the current dev tenant; override them
# to use a different one.
# AUTH0_ISSUER_URI=https://<tenant>.us.auth0.com/
# AUTH0_AUDIENCE=https://mockbank/api

# Management API credentials for AuthUser (POST /api/v1/iam/users). Optional:
# without them the service starts, and only that endpoint fails.
AUTH0_DOMAIN=
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
AUTH0_MGMT_AUDIENCE=
# Role granted to every customer this platform provisions. Generated per tenant
# (Auth0 dashboard, User Management > Roles), so it differs between tenants.
# Unset means AuthUser refuses to provision rather than creating a user with no
# role, who could sign in and then be refused everything.
AUTH0_CUSTOMER_ROLE_ID=

# --- JVM tuning ---------------------------------------------------------------
# Applied to every Java service. The default in docker-compose.yml is sized for
# eleven services sharing a laptop. Raise MaxRAMPercentage if you give Docker
# more memory.
# SERVICE_JAVA_OPTS=-XX:MaxRAMPercentage=50 -XX:+UseSerialGC -XX:TieredStopAtLevel=1 -Xss512k -XX:ReservedCodeCacheSize=64m

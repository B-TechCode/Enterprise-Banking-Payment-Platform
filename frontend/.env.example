# Copy to .env.local (git-ignored) and fill in. Vite only exposes VITE_ prefixed
# variables to the browser, and everything here is public by design: a SPA holds
# no secrets, which is why the Authorization Code flow with PKCE is used rather
# than anything involving a client secret.

# --- Auth0 -------------------------------------------------------------------
VITE_AUTH0_DOMAIN=dev-vkxlfm4oy207h5bq.us.auth0.com

# The SPA application's client id (Auth0 dashboard, Applications).
VITE_AUTH0_CLIENT_ID=

# Without this the access token comes back opaque and the API Gateway rejects
# it: the audience is what makes Auth0 issue a JWT for this platform's APIs.
VITE_AUTH0_AUDIENCE=https://mockbank/api

# Scopes the app asks for. accounts.write is deliberately absent - a customer
# needs it for nothing this application does.
VITE_AUTH0_SCOPE=openid profile email fdx:accounts.read fdx:transactions.read fdx:bill.read fdx:bill.write

# --- API ---------------------------------------------------------------------
# Requests go to /api in development and the Vite proxy forwards them to the
# gateway, so this is a path rather than an origin.
VITE_API_BASE_URL=/api
